{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "npm"
  },
  "newProjectRoot": "projects",
  "projects": {
    "dragon-quest-rpg": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "style": "scss"
        }
      },
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "src/main.ts",
            "tsConfig": "tsconfig.app.json",
            "inlineStyleLanguage": "scss",
            "allowedCommonJsDependencies": ["@xmldom/xmldom", "parse-svg-path"],
            "assets": [
              {
                "glob": "**/*",
                "input": "public"
              },
              {
                "glob": "**/*",
                "input": "src/assets",
                "output": "assets",
                "ignore": [
                  "1bitpack_kenney_1.2/**",
                  "kenney_tiny-battle/**",
                  "kenney_tinyDungeon/Tiled/**",
                  "kenney_tinyDungeon/Tilemap/**",
                  "kenney_tinyDungeon/*.png",
                  "**/*.aseprite",
                  "**/*.url",
                  "**/Buildings/**",
                  "**/Terrain/Tileset/**",
                  "**/Terrain/Resources/**",
                  "**/Terrain/Decorations/Clouds/**",
                  "**/Terrain/Decorations/Rocks in the Water/**",
                  "**/Terrain/Decorations/Rubber Duck/**",
                  "**/UI Elements/UI Banners from the store page/**",
                  "**/UI Elements/UI Elements/{Banners,Bars,Buttons,Cursors,Human Avatars,Ribbons,Swords,Wood Table}/**",
                  "**/Units/**/*Run*.png",
                  "**/Units/**/*_Defence.png",
                  "**/Units/**/*Gold.png",
                  "**/Units/**/*Meat.png",
                  "**/Units/**/*Wood.png",
                  "**/Units/**/*Idle Pickaxe.png",
                  "**/Units/**/*Interact Pickaxe.png",
                  "**/Units/**/*Heal_Effect.png",
                  "**/Particle FX/Water Splash.png"
                ]
              }
            ],
            "styles": ["src/styles.scss"]
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "1.3MB",
                  "maximumError": "2MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "28kB",
                  "maximumError": "40kB"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "dragon-quest-rpg:build:production"
            },
            "development": {
              "buildTarget": "dragon-quest-rpg:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "test": {
          "builder": "@angular/build:unit-test"
        }
      }
    }
  }
}
